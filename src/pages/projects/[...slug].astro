---
import { changeLanguage, t } from "i18next";
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProjectDetail from "@/components/sections/ProjectDetail.astro";
import { getProjects } from "@/utils/projects";

changeLanguage("spa");

export async function getStaticPaths() {
  const projects = await getProjects("spa");
  return projects.map(({ slug, entry }) => ({
    params: { slug },
    props: { project: entry },
  }));
}

const { project } = Astro.props;
const { title, description } = project.data;
---

<BaseLayout
  author="Elias Pereyra"
  title={t("project.pageTitle", { title })}
  description={description}
>
  <ProjectDetail project={project} />
</BaseLayout>
