---
import { t } from "i18next";
---

<p class="availability">
  <span class="availability__dot" aria-hidden="true"></span>
  {t("hero.available")}
</p>

<style>
  .availability {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.35rem 0.95rem 0.35rem 0.75rem;
    border: 1px solid color-mix(in oklab, var(--accent-pink) 45%, transparent);
    border-radius: 999px;
    background: color-mix(in oklab, var(--accent-pink) 9%, transparent);
    backdrop-filter: blur(6px);
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.4;
    color: var(--text-soft);
  }

  .availability__dot {
    position: relative;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--accent-pink);
    box-shadow: 0 0 10px var(--accent-pink);

    &::after {
      content: "";
      position: absolute;
      inset: 0;
      border-radius: inherit;
      background: inherit;
      animation: ping 1.6s cubic-bezier(0, 0, 0.2, 1) infinite;
    }
  }

  @keyframes ping {
    75%,
    100% {
      scale: 2.4;
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .availability__dot::after {
      animation: none;
    }
  }
</style>
