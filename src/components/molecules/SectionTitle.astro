---
interface Props {
  id?: string;
}

const { id } = Astro.props;
---

<h2 class="section-title" id={id} data-reveal><slot /></h2>

<style>
  .section-title {
    position: relative;
    display: inline-block;
    padding-top: 0.6rem;
    font-size: clamp(1.9rem, 1.4rem + 1.6vw, 2.25rem);
    font-weight: 700;
    line-height: 1.6;
    color: var(--text);

    &::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 2px;
      border-radius: var(--radius);
      background: var(--title-bar);
      transform-origin: left;
      transition: scale 0.9s var(--ease-out) 0.15s;
    }
  }

  :global(.js) .section-title:not(.is-visible)::before {
    scale: 0 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .section-title::before {
      transition: none;
    }
  }
</style>
