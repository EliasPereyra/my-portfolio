---
import { t } from "i18next";

import { Resend } from "resend";

const resend = new Resend("re_123456789");

// sanitizar las entradas

async function sendMail() {
  if (Astro.request.method === "POST") {
    try {
      const data = await Astro.request.formData();
      const name = data.get("name");
      const email = data.get("email");
      const subject = data.get("subject");
      const message = data.get("message");

      console.log({ name, email, subject, message });
    } catch (error) {
      if (error instanceof Error) {
        console.error(error.message);
      }
    }
  }

  const { data, error } = await resend.emails.send({
    from: "Acme <onboarding@resend.dev>",
    to: ["delivered@resend.dev"],
    subject: "Hello World",
    html: "<strong>It works!</strong>",
  });

  if (error) {
    return console.error({ error });
  }

  console.log({ data });
}
---

<form method="POST" class="form-wrapper">
  <label>Nombre:</label>
  <input type="text" name="name" required />
  <label>Email:</label>
  <input type="email" name="email" required />
  <label>Subject:</label>
  <input type="text" name="subject" required />
  <label>Your message:</label>
  <textarea rows="3" cols="20" name="message" required></textarea>
  <div class="form-wrapper__btn-wrapper">
    <button id="form-wrapper__send-btn">{t("contact.button")}</button>
  </div>
  <!-- usar la funcion sendMail -->
</form>

<style>
  .form-wrapper {
    display: flex;
    flex-direction: column;
    width: 35em;
    gap: 1em;

    label {
      font-size: 1.3rem;
      color: var(--white-c-800);
    }

    :is(input, textarea) {
      color: var(--black-c-800);
      padding: 0.9em 0.7em;
      background-color: var(--white-c-700);
      border-radius: 0.5rem;
    }

    textarea {
      resize: none;
      min-height: 10em;
    }

    .form-wrapper__btn-wrapper {
      margin-top: 2em;

      #form-wrapper__send-btn {
        color: var(--white-color);
        padding: 1em;
        border-radius: 0.5rem;
        font-size: 1rem;
        border: 1px solid hsla(259.2 45.4% 44.5%);
        background: hsla(0 2.9% 6.9%);
        box-shadow: 0px 0px 18px 8px hsla(200 33.3% 15.9%);
        transition:
          border,
          box-shadow 0.2s ease-out;
        &:hover {
          box-shadow: 0px 0px 18px 8px hsla(200 33.3% 26.5%);
          border: 1px solid hsla(259.1 44.7% 50.4%);
        }
      }
    }
  }

  @media screen and (max-width: 500px) {
    .form-wrapper {
      width: 100%;
    }
  }

  :global([data-theme="light"]) .form-wrapper {
    label {
      color: var(--primary-color);
    }

    .form-wrapper__btn-wrapper {
      #form-wrapper__send-btn {
        box-shadow: 0px 0px 38px 5px hsla(199.9 64.5% 56.9% / 0.439);

        &:hover {
          box-shadow: 0px 0px 38px 8px hsla(200.3 91.4% 68.2% / 0.907);
          border: 1px solid var(secondary-lighter__color);
        }
      }
    }
  }
</style>
