---
import i18next, { t } from "i18next";

import Icon from "@/components/atoms/Icon.astro";
import TechTag from "@/components/atoms/TechTag.astro";
import type { Project } from "@/utils/projects";

interface Props {
  project: Project;
  /** Figure number on the drawing, shown in the frame's caption bar */
  figure: number;
}

const { project, figure } = Astro.props;
const {
  title,
  slug,
  project_img,
  description,
  solved,
  highlightTags,
  live_link,
  repo_link,
  platform = "web",
} = project;

const detailHref = `${i18next.language === "eng" ? "/eng" : ""}/projects/${slug}`;
const host = live_link ? new URL(live_link).host.replace(/^www\./, "") : "";
---

<article class="project">
  <a
    class:list={[
      "project__media",
      "crop-marks",
      `project__media--${platform}`,
    ]}
    href={detailHref}
    tabindex="-1"
    aria-hidden="true"
  >
    <span class="project__bar">
      <span class="project__fig">{`FIG. ${String(figure).padStart(2, "0")}`}</span>
      {host && <span class="project__url">{host}</span>}
    </span>
    <span class="project__screen">
      <img
        src={project_img}
        alt=""
        width="331"
        height="235"
        loading="lazy"
        decoding="async"
      />
    </span>
  </a>
  <h3 class="project__title">
    <a href={detailHref}>{title}</a>
  </h3>
  <p class="project__description">{t(description.firstParagraph)}</p>
  <p class="project__solved">
    <strong>{t("projects.solvedLabel")}</strong>{" "}{t(solved)}
  </p>
  <ul class="project__tags" aria-label={t("experience.stack")}>
    {highlightTags.map((tag) => <TechTag name={tag} />)}
  </ul>
  <div class="project__links">
    <a class="project__more" href={detailHref}>
      {t("projects.caseStudy")}
      <span class="sr-only">{title}</span>
      <Icon name="arrow-right" size={16} />
    </a>
    {
      repo_link && (
        <a
          class="project__link"
          href={repo_link}
          target="_blank"
          rel="noopener noreferrer"
        >
          <Icon name="github" size={20} />
          {t("projects.code")}
          <span class="sr-only">{title}</span>
        </a>
      )
    }
    {
      live_link && (
        <a
          class="project__link"
          href={live_link}
          target="_blank"
          rel="noopener noreferrer"
        >
          <Icon name="globe" size={18} />
          {t("projects.site")}
          <span class="sr-only">{title}</span>
        </a>
      )
    }
  </div>
</article>

<style>
  .project {
    display: flex;
    flex-direction: column;
  }

  /* The screenshot is drawn as a figure: a hairline frame with crop marks and a caption bar */
  .project__media {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: var(--surface-raised);
    transition:
      border-color 0.35s ease,
      box-shadow 0.35s ease;
  }

  .project__bar {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 1.9rem;
    padding-inline: 0.75rem;
    border-bottom: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: var(--mono-xs);
    letter-spacing: 0.04em;
  }

  .project__fig {
    font-weight: 600;
    color: var(--accent-cyan);
  }

  .project__url {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--text-muted);
  }

  .project__screen {
    position: relative;
    z-index: 1;
    display: block;
    aspect-ratio: 331 / 235;
    overflow: hidden;

    img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: top;
      transition: scale 0.6s var(--ease-out);
    }
  }

  .project__media--mobile {
    .project__screen {
      align-self: center;
      width: min(42%, 10rem);
      aspect-ratio: 9 / 19;
      margin-block: 1.2rem;
      border: 4px solid light-dark(hsl(42 20% 86%), hsl(214 40% 18%));
      border-radius: 1.4rem;
    }
  }

  .project:has(a:hover, a:focus-visible) {
    .project__media {
      --crop-gap: 11px;
      --crop-color: var(--accent-pink);

      border-color: color-mix(in oklab, var(--accent-cyan) 70%, transparent);
      box-shadow: 0 20px 40px -24px
        color-mix(in oklab, var(--accent-cyan) 60%, transparent);
    }

    .project__screen img {
      scale: 1.03;
    }
  }

  .project__title {
    margin-top: 1.3rem;
    font-size: 1.375rem;
    font-weight: 500;
    line-height: 1.2;

    a {
      color: var(--text);
      transition: color 0.2s ease;

      &:hover {
        color: var(--accent-pink);
      }
    }
  }

  .project__description {
    margin-top: 1.05rem;
    font-size: 1rem;
    font-weight: 300;
    line-height: 1.55;
    color: var(--text);
  }

  .project__solved {
    margin-top: 0.8rem;
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--text-soft);

    strong {
      font-weight: 600;
      color: var(--text);
    }
  }

  .project__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem 0.75rem;
    margin-top: 1.3rem;
  }

  .project__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 1.5rem;
    margin-top: auto;
    padding-top: 1.8rem;
  }

  .project__more {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 2.75rem;
    font-weight: 600;
    font-size: 1rem;
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
    transition: color 0.2s ease;

    :global(svg) {
      transition: translate 0.25s var(--ease-out);
    }

    &:hover {
      color: var(--accent-pink);

      :global(svg) {
        translate: 4px 0;
      }
    }
  }

  .project__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.75rem;
    color: var(--text-soft);
    transition: color 0.2s ease;

    &:hover {
      color: var(--text);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project__screen img {
      transition: none;
    }
  }
</style>
