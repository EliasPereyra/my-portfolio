---
import i18next, { t } from "i18next";

import Icon from "@/components/atoms/Icon.astro";
import TechTag from "@/components/atoms/TechTag.astro";
import type { Project } from "@/utils/projects";

interface Props {
  project: Project;
}

const { project } = Astro.props;
const {
  title,
  slug,
  project_img,
  description,
  highlightTags,
  live_link,
  repo_link,
  platform = "web",
} = project;

const detailHref = `${i18next.language === "eng" ? "/eng" : ""}/projects/${slug}`;
const host = live_link ? new URL(live_link).host.replace(/^www\./, "") : "";
---

<article class="project">
  <a
    class:list={["project__media", `project__media--${platform}`]}
    href={detailHref}
    tabindex="-1"
    aria-hidden="true"
  >
    {
      platform === "web" && (
        <span class="project__bar">
          <span class="project__lights" />
          {host && <span class="project__url">{host}</span>}
        </span>
      )
    }
    <span class="project__screen">
      <img
        src={project_img}
        alt=""
        width="331"
        height="235"
        loading="lazy"
        decoding="async"
      />
    </span>
  </a>
  <h3 class="project__title">
    <a href={detailHref}>{title}</a>
  </h3>
  <p class="project__description">{t(description.firstParagraph)}</p>
  <ul class="project__tags" aria-label={t("experience.stack")}>
    {highlightTags.map((tag) => <TechTag name={tag} />)}
  </ul>
  <div class="project__links">
    <a class="project__more" href={detailHref}>
      {t("projects.seeMore")}
      <span class="sr-only">{title}</span>
      <Icon name="arrow-right" size={16} />
    </a>
    {
      repo_link && (
        <a
          class="project__icon-link"
          href={repo_link}
          target="_blank"
          rel="noopener noreferrer"
        >
          <Icon
            name="github"
            size={22}
            label={`${t("projects.repo")} ${title}`}
          />
        </a>
      )
    }
    {
      live_link && (
        <a
          class="project__icon-link"
          href={live_link}
          target="_blank"
          rel="noopener noreferrer"
        >
          <Icon
            name="globe"
            size={20}
            label={`${t("projects.live")} ${title}`}
          />
        </a>
      )
    }
  </div>
</article>

<style>
  .project {
    display: flex;
    flex-direction: column;
  }

  .project__media {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--surface-raised);
    box-shadow: 0 0 0 1px var(--line);
    transition: box-shadow 0.35s ease;
  }

  .project__bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: 1.9rem;
    padding-inline: 0.8rem;
    border-bottom: 1px solid var(--line);
  }

  .project__lights {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--line);
    box-shadow:
      12px 0 var(--line),
      24px 0 var(--line);
  }

  .project__url {
    padding: 0.1rem 0.9rem;
    border-radius: 999px;
    background: color-mix(in oklab, var(--text) 6%, transparent);
    font-size: 0.72rem;
    color: var(--text-muted);
  }

  .project__screen {
    position: relative;
    display: block;
    aspect-ratio: 331 / 235;
    overflow: hidden;

    img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: top;
      transition: scale 0.6s var(--ease-out);
    }

    /* Gloss sweep, same language as the hero headline */
    &::after {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(
        115deg,
        transparent 35%,
        hsla(0 0% 100% / 0.22) 50%,
        transparent 65%
      );
      translate: -110% 0;
      transition: translate 0.9s var(--ease-out);
    }
  }

  .project__media--mobile {
    display: grid;
    place-items: center;
    aspect-ratio: 331 / 265;
    padding-block: 1.2rem;

    .project__screen {
      height: 100%;
      aspect-ratio: 9 / 19;
      border: 4px solid light-dark(hsla(224 28.3% 89.6%), hsla(220 33.3% 15.9%));
      border-radius: 1.4rem;
    }
  }

  .project:has(a:hover, a:focus-visible) {
    .project__media {
      box-shadow:
        0 0 0 1px color-mix(in oklab, var(--accent-violet) 60%, transparent),
        0 18px 40px -18px color-mix(in oklab, var(--accent-violet) 55%, transparent);
    }

    .project__screen img {
      scale: 1.04;
    }

    .project__screen::after {
      translate: 110% 0;
    }
  }

  .project__title {
    margin-top: 1.3rem;
    font-size: 1.375rem;
    font-weight: 500;
    line-height: 1.2;

    a {
      color: var(--text);
      transition: color 0.2s ease;

      &:hover {
        color: var(--accent-pink);
      }
    }
  }

  .project__description {
    margin-top: 1.05rem;
    font-size: 1rem;
    font-weight: 300;
    line-height: 1.2;
    color: var(--text);
  }

  .project__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem 0.75rem;
    margin-top: 1.3rem;
  }

  .project__links {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: auto;
    padding-top: 2.4rem;
  }

  .project__more {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 1rem;
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
    transition: color 0.2s ease;

    :global(svg) {
      transition: translate 0.25s var(--ease-out);
    }

    &:hover {
      color: var(--accent-pink);

      :global(svg) {
        translate: 4px 0;
      }
    }
  }

  .project__icon-link {
    display: flex;
    color: var(--text-muted);
    transition: color 0.2s ease;

    &:hover {
      color: var(--text);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project__screen img,
    .project__screen::after {
      transition: none;
    }
  }
</style>
