---
import type { CollectionEntry } from "astro:content";
import PostCard from "../widgets/PostCard.astro";
import { t } from "i18next";

type Props = {
  posts: CollectionEntry<"posts">[];
};

const { posts } = Astro.props;
---

<section>
  <div id="radial-gradient__effect"></div>
  <h2>{t("blog.title")}</h2>
  <!-- list of 3 posts -->
  <ul id="list-posts">
    {
      posts.map((post) => (
        <PostCard
          img={post.data.coverImg}
          title={post.data.title}
          description={post.data.description}
          tags={post.data.tags}
          pubDate={post.data.publishDate}
        />
      ))
    }
  </ul>
</section>

<style>
  section {
    padding: 8em 10em;
    background: linear-gradient(380deg, hsla(223.3 90% 3.9%) -20%, hsla(241.8 32.7% 19.8%) 400%);
    position: relative;
    z-index: 10;
    position: relative;

    #radial-gradient__effect {
      background-image: radial-gradient(
          at 27% 37%,
          hsla(215, 98%, 61%, 1) 0px,
          transparent 0%
        ),
        radial-gradient(at 97% 21%, hsla(285 98.6% 72.2%) 0px, transparent 50%),
        radial-gradient(at 52% 99%, hsla(338.2 98% 61%) 0px, transparent 50%),
        radial-gradient(at 10% 29%, hsla(256, 96%, 67%, 1) 0px, transparent 50%),
        radial-gradient(at 97% 96%, hsla(281 59.4% 73.9%) 0px, transparent 50%),
        radial-gradient(at 33% 50%, hsla(222, 67%, 73%, 1) 0px, transparent 50%),
        radial-gradient(at 79% 53%, hsla(331.2 68.2% 79%) 0px, transparent 50%);
      position: absolute;
      width: 60em;
      z-index: -1;
      height: 90%;
      filter: blur(120px) saturate(200%);
      opacity: 0.1;
      top: 0;
      right: 10em;
    }

    &::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      background-image: url("/assets/grid.svg");
      z-index: -1;
      width: 100%;
      height: 100%;
      opacity: 0.4;
      filter: invert(0.85);
      mask-image: radial-gradient(ellipse at center, transparent 10%, black);
    }

    h2 {
      color: var(--white-color);
      margin-bottom: 1em;
    }

    #list-posts {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      justify-content: space-between;
      align-items: center;
      gap: 2em;
    }
  }

  :global([data-theme="light"]) section {
    background: var(--hero__light-bg);

    h3 {
      color: var(--black-c-800);
    }
  }
</style>
