---
import { t } from "i18next";

import Divider from "@/components/atoms/Divider.astro";
import SectionTitle from "@/components/molecules/SectionTitle.astro";
import ProjectCard from "@/components/widgets/ProjectCard.astro";
import { projects } from "@/utils/projects";
---

<section class="projects" id="portfolio" aria-labelledby="projects-title">
  <Divider />

  <div class="container">
    <SectionTitle sheet="portfolio" id="projects-title">{t("projects.title")}</SectionTitle>
    <div class="projects__grid">
      {
        projects.map((project, index) => (
          <ProjectCard
            project={project}
            figure={index + 1}
            featured={index === 0}
          />
        ))
      }
    </div>
  </div>
</section>

<style>
  .projects {
    position: relative;
    padding-block: var(--section-space);
  }

  /* The first project spans the full row; the rest pair up below it */
  .projects__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 4.5rem 5rem;
    margin-top: 3.3rem;

    @media (max-width: 760px) {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
