---
import { Image } from "astro:assets";

import { t } from "i18next";
import Icon from "@/components/atoms/Icon.astro";

import SpainFlagIcon from "@/assets/imgs/flag-of-spain.svg";
import GBFlagIcon from "@/assets/imgs/flag-of-gb.svg";

const { pathname } = Astro.url;

const isBlogPathname = pathname.includes("/blog");
const currentEngPathname = isBlogPathname ? "/eng/blog" : "/eng";
---

<div class="dropdown-wrapper">
  <div id="dropdown">
    <button
      class="dropdown-btn"
      popovertarget="dropdown-items"
      aria-label={t("navbar.languages")}
    >
      <Icon name="language" size={19} />
      <Icon name="caret-down" size={18} />
    </button>
  </div>
  <dialog popover id="dropdown-items">
    <a href={isBlogPathname ? "/blog" : "/"}
      ><Image src={SpainFlagIcon} alt="" /> Español</a
    >
    <a href={isBlogPathname ? "/eng/blog" : "/eng"}
      ><Image src={GBFlagIcon} alt="" /> English</a
    >
  </dialog>
</div>

<style>
  #dropdown {
    anchor-name: --lang-btn;
  }

  .dropdown-btn {
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 0.35rem 0.4rem;
    border-radius: 0.5rem;
    color: var(--text-soft);
    transition:
      color 0.2s ease,
      background-color 0.2s ease;

    &:hover {
      color: var(--accent-pink);
      background-color: color-mix(in oklab, var(--text) 8%, transparent);
    }
  }

  #dropdown-items {
    position-anchor: --lang-btn;
    position: absolute;
    inset: auto;
    top: anchor(bottom);
    right: anchor(right);
    position-try-fallbacks: --lang-left;
    width: max-content;
    margin: 0.35rem 0 0;
    padding: 0.55rem 0.77rem;
    overflow: hidden;

    display: none;
    opacity: 0;
    border: 1px solid var(--line);
    border-radius: 0.55rem;
    background: var(--surface);
    box-shadow: 0 12px 32px hsla(0 0% 0% / 0.25);
    transition:
      display 0.2s,
      opacity 0.2s;
    transition-behavior: allow-discrete;

    & > * {
      padding: 0.5rem;
    }

    &:popover-open {
      display: grid;
      opacity: 1;

      @starting-style {
        display: grid;
        opacity: 0;
      }
    }

    a {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.9rem;
      white-space: nowrap;
      color: var(--text);
      transition: color 0.15s ease-in;

      &:hover {
        color: var(--accent-pink);
      }
    }

    img {
      width: 20px;
      height: 20px;
      aspect-ratio: 1 / 1;
    }
  }

  @position-try --lang-left {
    inset: auto;
    top: anchor(bottom);
    left: anchor(left);
  }
</style>
