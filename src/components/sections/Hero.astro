---
import i18next, { t } from "i18next";

import Glow from "@/components/atoms/Glow.astro";
import GridSpot from "@/components/atoms/GridSpot.astro";
import Icon from "@/components/atoms/Icon.astro";
import { getCvHref, socialNetworks } from "@/utils/PageConfig";

const lang = i18next.language;
const projectsHref = `${lang === "eng" ? "/eng/" : "/"}#portfolio`;
---

<section class="hero" id="hero" data-spotlight>
  <Glow
    tone="cyan"
    style="top: -14rem; right: -18rem; width: 56rem; height: 52rem;"
    duration={36}
    dx="-3rem"
    dy="2rem"
  />
  <Glow
    tone="crimson"
    style="bottom: -20rem; left: -24rem; width: 50rem; height: 44rem;"
    duration={40}
    dx="3rem"
    dy="-2rem"
  />
  <GridSpot />

  <div class="container hero__layout">
    <div class="hero__content">
      <h1 class="hero__headline">
        <span class="hero__word" style="--i: 0">{t("hero.headline.start")}</span>
        <span class="hero__word hero__accent hero__accent--pink" style="--i: 1"
          >{t("hero.headline.web")}</span
        >
        <span class="hero__word" style="--i: 2">{t("hero.headline.middle")}</span>
        <span class="hero__word hero__accent hero__accent--cyan" style="--i: 3"
          >{t("hero.headline.mobile")}</span
        >
        <span class="hero__word" style="--i: 4">{t("hero.headline.end")}</span>
      </h1>
      <p class="hero__description">{t("hero.description")}</p>
      <div class="hero__actions">
        <a class="bp-button" href={projectsHref}>
          {t("hero.cta")}
          <Icon name="arrow-right" size={18} class="bp-button__nudge" />
        </a>
        <a
          class="hero__cv"
          href={getCvHref(lang)}
          target="_blank"
          rel="noopener noreferrer"
        >
          <Icon name="file" size={20} />
          {t("hero.cv")}
        </a>
        <ul class="hero__social">
          <li>
            <a
              href={socialNetworks.linkedinProfile}
              target="_blank"
              rel="noopener noreferrer"
            >
              <Icon name="linkedin" size={26} label="LinkedIn" />
            </a>
          </li>
          <li>
            <a
              href={socialNetworks.githubProfile}
              target="_blank"
              rel="noopener noreferrer"
            >
              <Icon name="github" size={26} label="GitHub" />
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Profile card: role, focus, base and availability at a glance -->
    <dl class="profile-card" aria-label={t("hero.profile.label")}>
      <div class="profile-card__cell">
        <dt>{t("hero.profile.role")}</dt>
        <dd>{t("hero.profile.roleValue")}</dd>
      </div>
      <div class="profile-card__cell">
        <dt>{t("hero.profile.focus")}</dt>
        <dd>{t("hero.profile.focusValue")}</dd>
      </div>
      <div class="profile-card__cell">
        <dt>{t("hero.profile.base")}</dt>
        <dd>{t("hero.profile.baseValue")}</dd>
      </div>
      <div class="profile-card__cell">
        <dt>{t("hero.profile.status")}</dt>
        <dd class="profile-card__status">
          <span class="profile-card__dot" aria-hidden="true"></span>
          {t("hero.available")}
        </dd>
      </div>
    </dl>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    align-items: center;
    /* Short enough that the next section's header shows in the first viewport */
    min-height: max(74svh, 36rem);
    padding-block: 7rem 3rem;
  }

  /* Rounded up to the grid, so the section below starts on a grid line */
  @supports (width: round(up, 1px, 1px)) {
    .hero {
      min-height: round(up, max(74svh, 36rem), var(--grid-minor-size));
    }
  }

  .hero__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 19rem;
    align-items: end;
    gap: 3rem 4rem;

    @media (max-width: 960px) {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .hero__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.4rem;
  }

  .hero__headline {
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.26em;
    max-width: 17ch;
    font-size: clamp(2.6rem, 1.3rem + 4.6vw, 4.6rem);
    font-weight: 700;
    line-height: 1.04;
    letter-spacing: -0.025em;
    color: var(--text);
  }

  .hero__word {
    display: inline-block;
    animation: word-in 0.8s var(--ease-out) both;
    animation-delay: calc(0.08s + var(--i) * 0.08s);
  }

  /* Emphasis words are underlined like a markup on the drawing */
  .hero__accent {
    position: relative;
    color: var(--accent);

    &::after {
      content: "";
      position: absolute;
      left: 0.04em;
      right: 0.04em;
      bottom: 0.02em;
      height: 2px;
      background: currentColor;
      opacity: 0.55;
      transform-origin: left;
      animation: underline-in 0.7s var(--ease-out) both;
      animation-delay: calc(0.75s + var(--i) * 0.1s);
    }
  }

  .hero__accent--pink {
    --accent: var(--accent-pink);
  }

  .hero__accent--cyan {
    --accent: var(--accent-cyan);
  }

  .hero__description {
    max-width: 34rem;
    font-size: clamp(1.15rem, 1rem + 0.45vw, 1.35rem);
    line-height: 1.45;
    color: var(--text-soft);
    animation: word-in 0.8s var(--ease-out) 0.45s both;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    margin-top: 0.6rem;
    animation: word-in 0.8s var(--ease-out) 0.55s both;
  }

  .hero__cv {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 2.9rem;
    font-weight: 600;
    color: var(--text-soft);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    text-decoration-color: color-mix(in oklab, currentColor 40%, transparent);
    transition: color 0.2s ease;

    &:hover {
      color: var(--text);
    }
  }

  .hero__social {
    display: flex;
    gap: 0.15rem;
    padding-left: 1.1rem;
    border-left: 1px solid var(--line);

    @media (max-width: 520px) {
      padding-left: 0;
      border-left: 0;
      margin-left: -0.6rem;
    }

    a {
      display: grid;
      place-items: center;
      width: 2.75rem;
      height: 2.75rem;
      color: var(--text-soft);
      transition:
        color 0.2s ease,
        translate 0.25s var(--ease-out);

      &:hover {
        color: var(--accent-pink);
        translate: 0 -2px;
      }
    }
  }

  /* Profile card */
  .profile-card {
    display: grid;
    border: 1px solid var(--line-strong);
    background: color-mix(in oklab, var(--bg-page) 78%, transparent);
    backdrop-filter: blur(3px);
    animation: block-in 0.9s var(--ease-out) 0.7s both;

    @media (max-width: 960px) {
      max-width: 26rem;
    }
  }

  .profile-card__cell {
    display: grid;
    gap: 0.2rem;
    padding: 0.6rem 0.85rem 0.65rem;
    border-top: 1px solid var(--line);

    &:first-child {
      border-top: 0;
    }
  }

  .profile-card dt {
    font-family: var(--font-mono);
    font-size: var(--mono-xs);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .profile-card dd {
    font-size: 0.95rem;
    font-weight: 500;
    line-height: 1.3;
    color: var(--text);
  }

  .profile-card__status {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }

  .profile-card__dot {
    position: relative;
    flex-shrink: 0;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--accent-pink);

    &::after {
      content: "";
      position: absolute;
      inset: 0;
      border-radius: inherit;
      background: inherit;
      animation: ping 1.8s cubic-bezier(0, 0, 0.2, 1) infinite;
    }
  }

  @keyframes word-in {
    from {
      opacity: 0;
      translate: 0 0.5em;
    }
  }

  @keyframes underline-in {
    from {
      scale: 0 1;
    }
  }

  @keyframes block-in {
    from {
      opacity: 0;
      clip-path: inset(0 0 100% 0);
    }

    to {
      clip-path: inset(0);
    }
  }

  @keyframes ping {
    75%,
    100% {
      scale: 2.4;
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__word,
    .hero__accent::after,
    .hero__description,
    .hero__actions,
    .profile-card,
    .profile-card__dot::after {
      animation: none;
    }
  }
</style>
