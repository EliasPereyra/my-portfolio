---
import i18next, { t } from "i18next";

import Glow from "@/components/atoms/Glow.astro";
import GridSpot from "@/components/atoms/GridSpot.astro";
import Icon from "@/components/atoms/Icon.astro";

const home = i18next.language === "eng" ? "/eng" : "/";
---

<main class="not-found drawing-sheet" data-sheet data-spotlight>
  <Glow
    tone="crimson"
    style="top: -10rem; left: -20rem; width: 50rem; height: 50rem;"
    dx="4rem"
    dy="2rem"
  />
  <Glow
    tone="cyan"
    style="bottom: -20rem; right: -18rem; width: 50rem; height: 50rem;"
    duration={32}
    dx="-3rem"
    dy="-2rem"
  />
  <GridSpot />

  <div class="container not-found__content">
    <p class="not-found__code" aria-hidden="true">404</p>
    <h1 class="not-found__title">{t("not_found.title")}</h1>
    <p class="not-found__desc">{t("not_found.desc")}</p>
    <a class="bp-button not-found__back" href={home}>
      <Icon name="arrow-left" size={18} class="bp-button__nudge" />
      {t("not_found.go_back")}
    </a>
  </div>
</main>

<style>
  .not-found {
    position: relative;
    display: grid;
    place-items: center;
    min-height: max(100svh, 32rem);
    padding-block: 6rem 4rem;
    background: var(--bg-flow);
  }

  .not-found__content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .not-found__code {
    font-family: var(--font-display);
    font-size: clamp(6rem, 3.5rem + 11vw, 11rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--accent-cyan);
    animation: rise 0.8s var(--ease-out) both;
  }

  .not-found__title {
    margin-top: 0.75rem;
    font-size: clamp(1.9rem, 1.4rem + 1.6vw, 2.5rem);
    font-weight: 700;
    line-height: 1.2;
    color: var(--text);
    animation: rise 0.8s var(--ease-out) 0.1s both;
  }

  .not-found__desc {
    max-width: 28rem;
    margin-top: 0.75rem;
    font-size: clamp(1.1rem, 1rem + 0.4vw, 1.3rem);
    line-height: 1.4;
    color: var(--text-soft);
    animation: rise 0.8s var(--ease-out) 0.2s both;
  }

  .not-found__back {
    margin-top: 2.2rem;
    animation: rise 0.8s var(--ease-out) 0.3s backwards;

    &:hover :global(svg) {
      translate: -3px 0;
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      translate: 0 0.6em;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .not-found__code,
    .not-found__title,
    .not-found__desc,
    .not-found__back {
      animation: none;
    }
  }
</style>
