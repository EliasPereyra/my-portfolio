---
import i18next, { t } from "i18next";

import LogoWhite from "../atoms/LogoWhite.astro";
import AstroIcon from "../atoms/AstroIcon.astro";

const home = i18next.language === "eng" ? "/eng/" : "/";
---

<footer class="footer">
  <div class="footer__inner">
    <a class="footer__logo" href={home} aria-label={t("navbar.home")}>
      <LogoWhite width="98" height="57" />
    </a>
    <p class="footer__made">
      {t("footer.tool-used")}
      <a href="https://astro.build" target="_blank" rel="noopener noreferrer" aria-label="Astro">
        <AstroIcon />
      </a>
    </p>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    background: var(--bg-footer);
    border-top: 1px solid var(--rail);
  }

  .footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    max-width: var(--container);
    margin-inline: auto;
    padding: 2.4rem clamp(1.25rem, -1rem + 7vw, 5.3rem);
  }

  .footer__logo {
    display: flex;
    color: var(--text);

    :global(svg) {
      width: 98px;
      height: 57px;
    }
  }

  .footer__made {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.875rem;
    font-weight: 300;
    color: light-dark(var(--text-soft), hsla(0 0% 85.1%));

    a {
      display: flex;
      color: var(--text);
      transition: opacity 0.2s ease;

      &:hover {
        opacity: 0.75;
      }
    }

    :global(svg) {
      width: 64px;
      height: auto;
    }
  }

  @media (max-width: 500px) {
    .footer__inner {
      flex-direction: column;
    }
  }
</style>
