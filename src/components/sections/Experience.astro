---
import i18next, { t } from "i18next";

import Divider from "@/components/atoms/Divider.astro";
import TechTag from "@/components/atoms/TechTag.astro";
import SectionTitle from "@/components/molecules/SectionTitle.astro";
import { experience, formatMonth } from "@/utils/experience";

const lang = i18next.language;
---

<section class="experience" id="experience" aria-labelledby="experience-title">
  <Divider />

  <div class="container">
    <SectionTitle sheet="experience" id="experience-title">{t("experience.title")}</SectionTitle>

    {
      experience.map(({ company, role, start, end, projects }) => (
        <article class="job">
          <header class="timeline__item timeline__item--job">
            <span class="timeline__dot timeline__dot--job" aria-hidden="true" />
            <p class="timeline__when">
              <span class="timeline__dates">
                <time datetime={start}>{formatMonth(start, lang)}</time>
                <span aria-hidden="true">–</span>
                <span class="sr-only">{t("experience.to")}</span>
                <time datetime={end}>{formatMonth(end, lang)}</time>
              </span>
            </p>
            <div>
              <h3 class="timeline__company">{company}</h3>
              <p class="timeline__role">{role}</p>
            </div>
          </header>

          <ol class="timeline" aria-label={t("experience.projects")}>
            {projects.map(({ id, name, tags }) => (
              <li class="timeline__item" data-timeline-item>
                <span class="timeline__dot" aria-hidden="true" />
                <p class="timeline__when">
                  <span class="timeline__domain">
                    {t(`experience.items.${id}.domain`)}
                  </span>
                </p>
                <div>
                  <h4 class="timeline__project">{name}</h4>
                  <p class="timeline__lead">
                    {t(`experience.items.${id}.lead`)}
                  </p>
                  <p class="timeline__description">
                    {t(`experience.items.${id}.description`)}
                  </p>
                  <ul class="timeline__tags" aria-label={t("experience.stack")}>
                    {tags.map((tag) => (
                      <TechTag name={tag} />
                    ))}
                  </ul>
                </div>
              </li>
            ))}
          </ol>
        </article>
      ))
    }
  </div>
</section>

<style>
  .experience {
    position: relative;
    padding-block: var(--section-space);
  }

  /*
   * One vertical line runs from the employer node down through its projects.
   * It starts at the employer node's center, so the square reads as its origin.
   */
  .job {
    --line-x: 0px;
    --dot: 14px;
    --job-dot: 18px;
    --job-dot-top: 9px;

    position: relative;
    display: grid;
    gap: 3rem;
    margin-top: 2.9rem;
    padding-left: 2.25rem;

    &::before,
    &::after {
      content: "";
      position: absolute;
      top: calc(var(--job-dot-top) + var(--job-dot) / 2);
      bottom: 0;
      left: var(--line-x);
      width: 1px;
    }

    &::before {
      background: var(--timeline-line);
      opacity: 0.45;
    }

    &::after {
      background: var(--accent-cyan);
      transform-origin: top;
    }
  }

  .timeline {
    display: grid;
    gap: 3.6rem;
  }

  @supports (animation-timeline: view()) {
    .job::after {
      animation: draw-line linear both;
      animation-timeline: view();
      animation-range: cover 10% cover 55%;
    }
  }

  .timeline__item {
    position: relative;
    display: grid;
    grid-template-columns: 12.5rem minmax(0, 46rem);
    column-gap: 3rem;

    @media (max-width: 760px) {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* Project nodes: a ring on the line that fills in pink as you reach it */
  .timeline__dot {
    position: absolute;
    top: 13px;
    left: calc(-2.25rem - var(--dot) / 2 + 0.5px);
    width: var(--dot);
    height: var(--dot);
    border: 1px solid var(--accent-cyan);
    border-radius: 50%;
    background: var(--bg-page);
    transition:
      background-color 0.4s ease,
      border-color 0.4s ease,
      box-shadow 0.45s ease;
  }

  /* The employer node is a survey mark: a square with a crosshair, centered on the same line */
  .timeline__dot--job {
    --dot: var(--job-dot);

    top: var(--job-dot-top);
    z-index: 1;
    border-radius: 2px;
    background:
      linear-gradient(var(--accent-cyan), var(--accent-cyan)) center / 100% 1px
        no-repeat,
      linear-gradient(var(--accent-cyan), var(--accent-cyan)) center / 1px 100%
        no-repeat,
      var(--bg-page);
  }

  .timeline__item.is-active .timeline__dot {
    border-color: var(--accent-pink);
    background: var(--accent-pink);
    box-shadow: 0 0 0 4px color-mix(in oklab, var(--accent-pink) 22%, transparent);
  }

  .timeline__when {
    display: grid;
    align-content: start;
    gap: 0.15rem;
    padding-top: 0.3rem;
    font-size: 0.875rem;
    line-height: 1.4;
    color: var(--text-muted);

    @media (max-width: 760px) {
      padding-top: 0;
      margin-bottom: 0.35rem;
    }
  }

  .timeline__dates {
    display: inline-flex;
    gap: 0.3rem;
    font-family: var(--font-mono);
    font-size: var(--mono-sm);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    color: var(--accent-cyan);
  }

  .timeline__company {
    font-size: clamp(1.5rem, 1.3rem + 0.6vw, 1.75rem);
    font-weight: 600;
    line-height: 1.25;
    color: var(--text);
  }

  .timeline__project {
    font-size: 1.375rem;
    font-weight: 500;
    line-height: 1.3;
    color: var(--text);
  }

  .timeline__lead {
    max-width: 62ch;
    margin-top: 0.45rem;
    font-size: 1.05rem;
    line-height: 1.5;
    color: var(--text);
  }

  .timeline__role {
    margin-top: 0.2rem;
    font-size: 1rem;
    line-height: 1.3;
    color: var(--accent-role);
  }

  .timeline__description {
    max-width: 62ch;
    margin-top: 0.6rem;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text-soft);
  }

  .timeline__domain {
    font-family: var(--font-mono);
    font-size: var(--mono-xs);
    color: var(--text-soft);
  }

  .timeline__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 0.65rem;
    margin-top: 0.9rem;
  }

  @keyframes draw-line {
    from {
      scale: 1 0;
    }

    to {
      scale: 1 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .job::after {
      animation: none;
    }

    .timeline__dot {
      transition: none;
    }
  }
</style>

<script>
  const setup = () => {
    const items = document.querySelectorAll<HTMLElement>(
      "[data-timeline-item]",
    );
    if (!items.length || !("IntersectionObserver" in window)) return;

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          items.forEach((item) =>
            item.classList.toggle("is-active", item === entry.target),
          );
        }
      },
      { rootMargin: "-40% 0px -55% 0px" },
    );

    items.forEach((item) => observer.observe(item));
    document.addEventListener(
      "astro:before-swap",
      () => observer.disconnect(),
      { once: true },
    );
  };

  document.addEventListener("astro:page-load", setup);
</script>
