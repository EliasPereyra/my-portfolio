---
import i18next, { t } from "i18next";

import Divider from "@/components/atoms/Divider.astro";
import Icon from "@/components/atoms/Icon.astro";
import SectionTitle from "@/components/molecules/SectionTitle.astro";

const home = i18next.language === "eng" ? "/eng/" : "/";
const projectBase = i18next.language === "eng" ? "/eng/projects" : "/projects";

// Each capability points at the place on the site that proves it
const capabilities = [
  { id: "design", href: `${home}#experience` },
  { id: "mobile", href: `${home}#experience` },
  { id: "product", href: `${home}#portfolio` },
  { id: "quality", href: `${projectBase}/workstart#how-title` },
];
---

<section
  class="capabilities"
  id="capabilities"
  aria-labelledby="capabilities-title"
>
  <Divider />
  <div class="container">
    <SectionTitle id="capabilities-title"
      >{t("capabilities.title")}</SectionTitle
    >
    <ul class="capabilities__list">
      {
        capabilities.map(({ id, href }) => (
          <li class="capability">
            <h3 class="capability__title">
              {t(`capabilities.items.${id}.title`)}
            </h3>
            <p class="capability__text">{t(`capabilities.items.${id}.text`)}</p>
            <a class="capability__proof" href={href}>
              {t(`capabilities.items.${id}.proof`)}
              <Icon name="arrow-right" size={16} />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .capabilities {
    position: relative;
    padding-block: clamp(3.5rem, 2rem + 4vw, 6rem) var(--section-space);
  }

  .capabilities__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 3rem clamp(2.5rem, 1rem + 4vw, 5rem);
    margin-top: 2.6rem;

    @media (max-width: 760px) {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.4rem;
    }
  }

  /* A hairline with a short accent run, echoing the section title bar */
  .capability {
    position: relative;
    display: flex;
    flex-direction: column;
    padding-top: 1.4rem;
    border-top: 1px solid var(--line);

    &::before {
      content: "";
      position: absolute;
      top: -1px;
      left: 0;
      width: 2.75rem;
      height: 2px;
      background: var(--title-bar);
    }
  }

  .capability__title {
    font-size: clamp(1.25rem, 1.1rem + 0.4vw, 1.45rem);
    font-weight: 600;
    line-height: 1.3;
    color: var(--text);
  }

  .capability__text {
    max-width: 60ch;
    margin-top: 0.7rem;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--text-soft);
  }

  .capability__proof {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    gap: 0.4rem;
    min-height: 2.75rem;
    margin-top: 0.4rem;
    font-weight: 600;
    color: var(--text);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    text-decoration-color: color-mix(
      in oklab,
      var(--accent-pink) 60%,
      transparent
    );
    transition: color 0.2s ease;

    :global(svg) {
      transition: translate 0.25s var(--ease-out);
    }

    &:hover {
      color: var(--accent-pink);

      :global(svg) {
        translate: 4px 0;
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .capability__proof :global(svg) {
      transition: none;
    }
  }
</style>
