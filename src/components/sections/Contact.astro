---
import i18next, { t } from "i18next";

import Divider from "@/components/atoms/Divider.astro";
import Glow from "@/components/atoms/Glow.astro";
import GridSpot from "@/components/atoms/GridSpot.astro";
import Icon from "@/components/atoms/Icon.astro";
import { getCvHref, socialNetworks } from "@/utils/PageConfig";
import { SHEET_TOTAL, sheetNumber } from "@/utils/sheets";

const email = socialNetworks.emailAddress;
const sheetRef = `H-${sheetNumber("contact")}`;
const sheetTotal = `/${String(SHEET_TOTAL).padStart(2, "0")}`;
---

<section
  class="contact"
  id="contact"
  aria-labelledby="contact-title"
  data-spotlight
>
  <Divider offset="var(--section-space)" />
  <Glow
    tone="crimson"
    style="top: 0rem; right: -14rem; width: 44rem; height: 40rem;"
    duration={30}
    dx="-2rem"
    dy="2rem"
  />
  <GridSpot />

  <div class="container">
   <div class="contact__content crop-marks">
    <span class="contact__ref" aria-hidden="true"
      >{sheetRef}<span>{sheetTotal}</span></span
    >
    <h2 class="contact__title" id="contact-title">{t("contact.title")}</h2>
    <p class="contact__subtitle">{t("contact.subtitle")}</p>

    <div class="contact__actions">
      <div class="contact__email">
        <a class="bp-button" href={`mailto:${email}`}>
          <Icon name="mail" size={20} />
          {t("contact.write")}
        </a>
        <span class="contact__address">{email}</span>
        <button
          class="contact__copy"
          type="button"
          data-copy-email={email}
          aria-label={t("contact.copy")}
        >
          <Icon name="copy" size={18} class="icon-copy" />
          <Icon name="check" size={18} class="icon-check" />
        </button>
        <span
          class="contact__toast"
          role="status"
          data-copy-status
          data-message={t("contact.copied")}></span>
      </div>

      <ul class="contact__links">
        <li>
          <a
            href={socialNetworks.linkedinProfile}
            target="_blank"
            rel="noopener noreferrer"
          >
            <Icon name="linkedin" size={28} label="LinkedIn" />
          </a>
        </li>
        <li>
          <a
            href={socialNetworks.githubProfile}
            target="_blank"
            rel="noopener noreferrer"
          >
            <Icon name="github" size={28} label="GitHub" />
          </a>
        </li>
        <li>
          <a
            class="contact__cv"
            href={getCvHref(i18next.language)}
            target="_blank"
            rel="noopener noreferrer"
          >
            <Icon name="file" size={20} />
            {t("contact.cv")}
          </a>
        </li>
      </ul>
    </div>
   </div>
  </div>
</section>

<style>
  .contact {
    --contact-space: clamp(3.5rem, 2rem + 5vw, 6.5rem);

    position: relative;
    padding-block: calc(var(--section-space) + var(--contact-space))
      calc(var(--section-space) * 0.8);
  }

  /* The closing block of the drawing: framed, with crop marks and the last sheet number */
  .contact__content {
    display: grid;
    justify-items: start;
    padding: clamp(2rem, 1rem + 4vw, 3.5rem) clamp(1.25rem, 0.5rem + 4vw, 3.5rem);
    border: 1px solid var(--line-strong);
    background: color-mix(in oklab, var(--bg-page) 72%, transparent);
  }

  .contact__ref {
    position: absolute;
    top: 0.85rem;
    right: 1rem;
    font-family: var(--font-mono);
    font-size: var(--mono-xs);
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--accent-cyan);

    span {
      color: var(--text-muted);
    }
  }

  .contact__title {
    font-size: clamp(2.3rem, 1.4rem + 3.4vw, 3.5rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.025em;
    color: var(--text);
  }

  .contact__subtitle {
    /* Two or three comfortable lines for the longer pitch */
    max-width: min(40rem, 68ch);
    margin-top: 0.6rem;
    font-size: clamp(1.15rem, 1rem + 0.5vw, 1.375rem);
    font-weight: 400;
    line-height: 1.6;
    color: var(--text-soft);
  }

  .contact__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 2rem;
    margin-top: 2.2rem;
  }

  .contact__email {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  .contact__address {
    padding-inline: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--mono-sm);
    color: var(--text-soft);
    overflow-wrap: anywhere;
    user-select: all;
  }

  .contact__copy {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    color: var(--text-soft);
    transition:
      color 0.2s ease,
      border-color 0.2s ease;

    &:hover {
      color: var(--text);
      border-color: var(--text-muted);
    }

    :global(svg) {
      grid-area: 1 / 1;
      transition:
        opacity 0.2s ease,
        scale 0.3s var(--ease-out);
    }

    :global(.icon-check) {
      opacity: 0;
      scale: 0.5;
      color: var(--accent-pink);
    }

    &.is-copied {
      :global(.icon-copy) {
        opacity: 0;
        scale: 0.5;
      }

      :global(.icon-check) {
        opacity: 1;
        scale: 1;
      }
    }
  }

  .contact__toast {
    position: absolute;
    right: 1.3rem;
    bottom: calc(100% + 0.6rem);
    padding: 0.35rem 0.75rem;
    border: 1px solid color-mix(in oklab, var(--accent-pink) 35%, var(--line));
    border-radius: var(--radius);
    background: var(--surface-raised);
    box-shadow: 0 10px 24px -12px light-dark(hsla(223.6 47.8% 9% / 0.35), hsla(0
            0% 0% / 0.7));
    font-size: 0.85rem;
    font-weight: 500;
    white-space: nowrap;
    color: var(--accent-pink);
    pointer-events: none;
    opacity: 0;
    translate: 50% 0.35rem;
    scale: 0.95;
    transition:
      opacity 0.2s ease,
      translate 0.3s var(--ease-out),
      scale 0.3s var(--ease-out);

    &::after {
      content: "";
      position: absolute;
      top: 100%;
      left: 50%;
      width: 0.5rem;
      height: 0.5rem;
      border: inherit;
      border-top: 0;
      border-left: 0;
      background: inherit;
      translate: -50% -50%;
      rotate: 45deg;
    }

    &.is-shown {
      opacity: 1;
      translate: 50% 0;
      scale: 1;
    }
  }

  .contact__links {
    display: flex;
    align-items: center;
    gap: 0.5rem;

    a {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 2.75rem;
      min-height: 2.75rem;
      gap: 0.3rem;
      color: var(--text-soft);
      transition:
        color 0.2s ease,
        translate 0.25s var(--ease-out);

      &:hover {
        color: var(--accent-pink);
        translate: 0 -2px;
      }
    }
  }

  .contact__cv {
    font-weight: 600;
  }

  @media (prefers-reduced-motion: reduce) {
    .contact__toast {
      transition: none;
    }
  }
</style>

<script>
  const setup = () => {
    const button =
      document.querySelector<HTMLButtonElement>("[data-copy-email]");
    const status = document.querySelector<HTMLElement>("[data-copy-status]");
    if (!button || !status) return;

    let timer: number | undefined;
    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copyEmail ?? "");
      } catch {
        return;
      }
      button.classList.add("is-copied");
      status.textContent = status.dataset.message ?? "";
      status.classList.add("is-shown");
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        button.classList.remove("is-copied");
        status.classList.remove("is-shown");
        // Clear once faded out, so the live region announces again on the next copy
        timer = window.setTimeout(() => (status.textContent = ""), 300);
      }, 2500);
    });
  };

  document.addEventListener("astro:page-load", setup);
</script>
