---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import i18next, { t } from "i18next";
import Glow from "@/components/atoms/Glow.astro";
import Icon from "@/components/atoms/Icon.astro";
import TechTag from "@/components/atoms/TechTag.astro";
import SectionTitle from "@/components/molecules/SectionTitle.astro";
import { projects } from "@/utils/projects";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const {
  title,
  description,
  summary,
  project_img,
  github_repo,
  live_link,
  key_features,
  design_goals,
} = project.data;

const isEng = i18next.language === "eng";
const back = isEng ? "/eng/#portfolio" : "/#portfolio";
const contactHref = isEng ? "/eng/#contact" : "/#contact";
const host = live_link ? new URL(live_link).host.replace(/^www\./, "") : "";
const index = projects.findIndex(
  (item) => item.title.toLowerCase() === title.toLowerCase(),
);
const tags = projects[index]?.tags ?? [];
// Wraps around, so the last project points back to the first
const next =
  projects.length > 1 ? projects[(index + 1) % projects.length] : undefined;
const nextHref = next && `${isEng ? "/eng" : ""}/projects/${next.slug}`;
---

<main class="project-page" transition:animate="slide">
  <Glow
    tone="crimson"
    style="top: -8rem; left: -26rem; width: 54rem; height: 54rem;"
    dx="4rem"
    dy="2rem"
  />
  <Glow
    tone="violet"
    style="top: 20rem; right: -24rem; width: 50rem; height: 50rem;"
    duration={32}
    dx="-3rem"
    dy="3rem"
  />
  <Glow
    tone="plum"
    style="bottom: -20rem; left: calc(50% - 30rem); width: 60rem; height: 50rem;"
    duration={38}
    dx="2rem"
    dy="-2rem"
  />

  <div class="container">
    <a class="project-page__back" href={back}>
      <Icon name="arrow-left" size={18} />
      {t("project.back")}
    </a>

    <header class="project-hero">
      <div class="project-hero__text">
        <h1 class="project-hero__title">{title}</h1>
        <p class="project-hero__lead">{description}</p>
        <div class="project-hero__actions">
          {
            live_link && (
              <a
                class="project-hero__live"
                href={live_link}
                target="_blank"
                rel="noopener noreferrer"
              >
                <Icon name="globe" size={18} />
                {t("project.live")}
                <Icon name="arrow-up-right" size={16} />
              </a>
            )
          }
          <a
            class="project-hero__repo"
            href={github_repo}
            target="_blank"
            rel="noopener noreferrer"
          >
            <Icon name="github" size={22} />
            {t("project.repo")}
          </a>
        </div>
      </div>

      <figure class="project-hero__media">
        <span class="project-hero__bar" aria-hidden="true">
          <span class="project-hero__lights"></span>
          {host && <span class="project-hero__url">{host}</span>}
        </span>
        <Image
          src={project_img}
          alt={t("project.coverAlt", { title })}
          loading="eager"
        />
      </figure>
    </header>

    <section class="project-block" aria-labelledby="overview-title">
      <SectionTitle id="overview-title">{t("project.overview")}</SectionTitle>
      <p class="project-block__summary">{summary}</p>
    </section>

    <section class="project-block" aria-labelledby="features-title">
      <SectionTitle id="features-title">{t("project.keyFeatures")}</SectionTitle
      >
      <ul class="project-features">
        {
          key_features.map((feature) => (
            <li>
              <Icon name="check" size={18} class="project-features__icon" />
              {feature}
            </li>
          ))
        }
      </ul>
    </section>

    {
      design_goals.length > 0 && (
        <section class="project-block" aria-labelledby="how-title">
          <SectionTitle id="how-title">{t("project.howBuilt")}</SectionTitle>
          <ol class="project-decisions">
            {design_goals.map((goal, index) => (
              <li class="project-decision">
                <span class="project-decision__index" aria-hidden="true">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <h3 class="project-decision__title">{goal.title}</h3>
                <p class="project-decision__text">{goal.description}</p>
              </li>
            ))}
          </ol>
        </section>
      )
    }

    {
      tags.length > 0 && (
        <section class="project-block" aria-labelledby="stack-title">
          <SectionTitle id="stack-title">{t("project.toolsUsed")}</SectionTitle>
          <ul class="project-stack">
            {tags.map((tag) => (
              <TechTag name={tag} />
            ))}
          </ul>
        </section>
      )
    }

    <nav class="project-end" aria-label={t("project.next")}>
      {
        next && (
          <a class="project-end__next" href={nextHref}>
            <span class="project-end__label">{t("project.next")}</span>
            <span class="project-end__title">
              {next.title}
              <Icon name="arrow-right" size={22} />
            </span>
          </a>
        )
      }
      <div class="project-end__talk">
        <span class="project-end__label">{t("project.talk")}</span>
        <a class="project-end__cta" href={contactHref}>
          <Icon name="mail" size={18} />
          {t("project.talkCta")}
        </a>
      </div>
    </nav>
  </div>
</main>

<style>
  .project-page {
    position: relative;
    padding-block: 7rem var(--section-space);
    background: var(--bg-flow);

    /* Same side rails as the home page */
    &::before {
      content: "";
      position: absolute;
      top: 0;
      bottom: 0;
      left: 50%;
      z-index: 1;
      width: min(var(--container), 100% - 1.25rem);
      translate: -50% 0;
      border-inline: 1px solid var(--rail);
      pointer-events: none;
    }
  }

  .project-page__back {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.95rem;
    color: var(--text-muted);
    transition: color 0.2s ease;

    :global(svg) {
      transition: translate 0.25s var(--ease-out);
    }

    &:hover {
      color: var(--text);

      :global(svg) {
        translate: -3px 0;
      }
    }
  }

  .project-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    align-items: center;
    gap: var(--split-gap);
    margin-top: 2.5rem;

    @media (max-width: 860px) {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }

  .project-hero__title {
    font-size: clamp(2.6rem, 1.8rem + 3vw, 4rem);
    font-weight: 700;
    line-height: 1.05;
    background: linear-gradient(
      100deg,
      var(--text) 30%,
      var(--accent-violet),
      var(--accent-pink)
    );
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: rise 0.8s var(--ease-out) both;
  }

  .project-hero__lead {
    max-width: 34rem;
    margin-top: 1.2rem;
    font-size: clamp(1.15rem, 1rem + 0.5vw, 1.35rem);
    line-height: 1.5;
    color: var(--text-soft);
    animation: rise 0.8s var(--ease-out) 0.1s both;
  }

  .project-hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.2rem;
    margin-top: 2rem;
    animation: rise 0.8s var(--ease-out) 0.2s both;
  }

  .project-hero__live {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.7rem 1.3rem;
    border: 1px solid transparent;
    border-radius: 999px;
    background:
      linear-gradient(var(--surface), var(--surface)) padding-box,
      linear-gradient(90deg, var(--accent-violet), var(--accent-pink))
        border-box;
    font-weight: 600;
    color: var(--text);
    transition:
      box-shadow 0.3s ease,
      translate 0.25s var(--ease-out);

    &:hover {
      translate: 0 -2px;
      box-shadow: 0 10px 30px -12px color-mix(in oklab, var(--accent-pink) 70%, transparent);
    }
  }

  .project-hero__repo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
    color: var(--text-muted);
    transition: color 0.2s ease;

    &:hover {
      color: var(--text);
    }
  }

  .project-hero__media {
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--surface-raised);
    box-shadow:
      0 0 0 1px var(--line),
      0 30px 60px -30px color-mix(in oklab, var(--accent-violet) 45%, transparent);
    animation: rise 0.9s var(--ease-out) 0.15s both;

    img {
      display: block;
      width: 100%;
      height: auto;
      aspect-ratio: 331 / 235;
      object-fit: cover;
      object-position: top;
    }
  }

  .project-hero__bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: 2.1rem;
    padding-inline: 0.9rem;
    border-bottom: 1px solid var(--line);
  }

  .project-hero__lights {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--line);
    box-shadow:
      13px 0 var(--line),
      26px 0 var(--line);
  }

  .project-hero__url {
    padding: 0.1rem 1rem;
    border-radius: 999px;
    background: color-mix(in oklab, var(--text) 6%, transparent);
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .project-block {
    margin-top: clamp(4rem, 2.5rem + 4vw, 6rem);
  }

  .project-block__summary {
    max-width: 46rem;
    margin-top: 1.6rem;
    font-size: clamp(1.15rem, 1rem + 0.45vw, 1.3rem);
    line-height: 1.6;
    color: var(--text);
  }

  .project-features {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem 2.5rem;
    max-width: 56rem;
    margin-top: 1.8rem;
    list-style: none;

    @media (max-width: 640px) {
      grid-template-columns: 1fr;
    }

    li {
      display: flex;
      align-items: flex-start;
      gap: 0.7rem;
      line-height: 1.5;
      color: var(--text-soft);
    }

    :global(.project-features__icon) {
      flex-shrink: 0;
      margin-top: 0.15rem;
      color: var(--accent-violet);
    }
  }

  .project-decisions {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
    margin-top: 1.8rem;
    list-style: none;

    @media (max-width: 760px) {
      grid-template-columns: 1fr;
    }
  }

  /* An odd last card takes the full row instead of leaving a gap */
  .project-decision:last-child:nth-child(odd) {
    grid-column: 1 / -1;
  }

  .project-decision {
    padding: 1.6rem 1.7rem 1.8rem;
    border-radius: var(--radius);
    background: color-mix(in oklab, var(--surface) 70%, transparent);
    box-shadow: 0 0 0 1px var(--line);
    transition: box-shadow 0.35s ease;

    &:hover {
      box-shadow:
        0 0 0 1px color-mix(in oklab, var(--accent-violet) 60%, transparent),
        0 18px 40px -22px color-mix(in oklab, var(--accent-violet) 55%, transparent);
    }
  }

  .project-decision__index {
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--accent-pink);
  }

  .project-decision__title {
    margin-top: 0.6rem;
    font-size: 1.2rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .project-decision__text {
    max-width: 68ch;
    margin-top: 0.6rem;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--text-soft);
  }

  .project-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem 0.75rem;
    margin-top: 1.8rem;
    list-style: none;
  }

  .project-end {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem 3rem;
    margin-top: clamp(4.5rem, 3rem + 4vw, 7rem);
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }

  .project-end__label {
    display: block;
    font-size: 0.95rem;
    color: var(--text-soft);
  }

  .project-end__next {
    display: grid;
    gap: 0.35rem;
    color: var(--text);

    :global(svg) {
      transition: translate 0.25s var(--ease-out);
    }

    &:hover {
      .project-end__title {
        color: var(--accent-pink);
      }

      :global(svg) {
        translate: 5px 0;
      }
    }
  }

  .project-end__title {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: clamp(1.8rem, 1.3rem + 1.8vw, 2.5rem);
    font-weight: 700;
    line-height: 1.15;
    transition: color 0.2s ease;
  }

  .project-end__talk {
    display: grid;
    justify-items: start;
    gap: 0.7rem;
  }

  .project-end__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 2.9rem;
    padding: 0.7rem 1.3rem;
    border: 1px solid transparent;
    border-radius: 999px;
    background:
      linear-gradient(var(--surface), var(--surface)) padding-box,
      linear-gradient(90deg, var(--accent-violet), var(--accent-pink))
        border-box;
    font-weight: 600;
    color: var(--text);
    transition:
      box-shadow 0.3s ease,
      translate 0.25s var(--ease-out);

    &:hover {
      translate: 0 -2px;
      box-shadow: 0 10px 30px -12px color-mix(in oklab, var(--accent-pink) 70%, transparent);
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      translate: 0 0.6em;
      filter: blur(6px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-hero__title,
    .project-hero__lead,
    .project-hero__actions,
    .project-hero__media {
      animation: none;
    }
  }
</style>
