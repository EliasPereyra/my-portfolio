---
import i18next, { t } from "i18next";

import Divider from "@/components/atoms/Divider.astro";
import Icon from "@/components/atoms/Icon.astro";
import SectionTitle from "@/components/molecules/SectionTitle.astro";
import { contributions, freeCodeCampProfile } from "@/utils/contributions";

const dateFormat = new Intl.DateTimeFormat(
  i18next.language === "eng" ? "en" : "es",
  {
    year: "numeric",
    month: "long",
    day: "numeric",
    timeZone: "UTC",
  },
);
---

<section
  class="contributions"
  id="contributions"
  aria-labelledby="contributions-title"
>
  <Divider />

  <div class="container">
    <SectionTitle sheet="contributions" id="contributions-title"
      >{t("contributions.title")}</SectionTitle
    >

    <div class="contributions__layout">
      <div class="contributions__text">
        <p set:html={t("contributions.first")} />
        <p set:html={t("contributions.second")} />
      </div>

      <div class="contributions__deck-wrapper">
        <ul class="deck" aria-label={t("contributions.deckLabel")}>
          {
            contributions.map(({ title, originalAuthor, date, url }, index) => (
              <li class="deck__card" style={`--i: ${index}`}>
                <a href={url} target="_blank" rel="noopener noreferrer">
                  <span class="deck__ref" aria-hidden="true">
                    {`N.º ${String(index + 1).padStart(2, "0")}`}
                  </span>
                  <time datetime={date}>
                    {dateFormat.format(new Date(date))}
                  </time>
                  <span class="deck__title">{title}</span>
                  <span class="deck__author">
                    <strong>{t("contributions.author")}</strong>{" "}
                    {originalAuthor}
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
        <a
          class="contributions__all"
          href={freeCodeCampProfile}
          target="_blank"
          rel="noopener noreferrer"
        >
          {t("contributions.seeAll")}
          <Icon name="arrow-up-right" size={16} />
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .contributions {
    position: relative;
    padding-block: var(--section-space);
  }

  .contributions__layout {
    display: grid;
    grid-template-columns: minmax(0, var(--split-text)) minmax(0, 26.9rem);
    gap: 3rem var(--split-gap);
    margin-top: 2rem;

    @media (max-width: 900px) {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .contributions__text {
    display: grid;
    gap: 1.6rem;

    p {
      font-size: clamp(1.15rem, 1rem + 0.5vw, 1.375rem);
      line-height: 1.45;
      color: var(--text-soft);
    }

    :global(strong) {
      font-weight: 600;
      color: var(--accent-pink);
    }
  }

  .contributions__deck-wrapper {
    align-content: start;
    display: grid;
    gap: 1.6rem;
  }

  /* Three stacked sheets; hovering one slides it out of the pile */
  .deck {
    --card-w: 14.4rem;
    --card-h: 17.6rem;
    --step: calc((100% - var(--card-w)) / 2);

    position: relative;
    height: var(--card-h);
  }

  .deck__card {
    position: absolute;
    top: 0;
    left: calc(var(--i) * var(--step));
    z-index: calc(3 - var(--i));
    width: var(--card-w);
    height: 100%;

    a {
      position: relative;
      display: flex;
      flex-direction: column;
      height: 100%;
      padding: 2.9rem 1.5rem 1.4rem;
      overflow: hidden;
      border: 1px solid var(--line-strong);
      border-radius: var(--radius);
      background: var(--surface);
      color: var(--text);
      box-shadow: -14px 0 28px -18px light-dark(hsla(216 45% 13% / 0.3), hsla(0 0% 0% / 0.7));
      transition:
        translate 0.55s var(--ease-out),
        box-shadow 0.35s ease,
        border-color 0.35s ease;

      /* A sheet's top margin line */
      &::before {
        content: "";
        position: absolute;
        inset: 2rem 0 auto;
        height: 1px;
        background: var(--line);
      }
    }
  }

  .deck__ref {
    position: absolute;
    top: 0.6rem;
    right: 0.8rem;
    font-family: var(--font-mono);
    font-size: var(--mono-xs);
    line-height: 0.8rem;
    letter-spacing: 0.06em;
    color: var(--accent-cyan);
  }

  .deck__card time {
    position: absolute;
    top: 0.6rem;
    left: 0.8rem;
    font-family: var(--font-mono);
    font-size: var(--mono-xs);
    line-height: 0.8rem;
    color: var(--text-muted);
  }

  .deck__title {
    display: -webkit-box;
    overflow: hidden;
    font-size: 1.3rem;
    line-height: 1.2;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 6;
  }

  .deck__author {
    margin-top: auto;
    font-size: 0.9rem;
    color: var(--text-soft);

    strong {
      font-weight: 700;
      color: var(--text);
    }
  }

  .deck .deck__card:has(~ .deck__card:is(:hover, :focus-within)) {
    z-index: calc(4 + var(--i));
  }

  .deck .deck__card:is(:hover, :focus-within) {
    z-index: 10;

    a {
      translate: -2.25rem 0;
      border-color: var(--accent-cyan);
      box-shadow: 0 22px 40px -22px color-mix(in oklab, var(--accent-cyan) 60%, transparent);
    }
  }

  /* Narrow screens: one sheet at a time, swiped sideways */
  @media (max-width: 900px) {
    .deck {
      display: flex;
      gap: 1rem;
      height: auto;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      padding-bottom: 0.75rem;
    }

    .deck__card,
    .deck .deck__card:is(:hover, :focus-within) {
      position: relative;
      left: auto;
      flex: 0 0 var(--card-w);
      height: var(--card-h);
      scroll-snap-align: start;

      a {
        translate: none;
      }
    }
  }

  .contributions__all {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    width: fit-content;
    font-weight: 700;
    color: var(--text);
    transition: color 0.2s ease;

    :global(svg) {
      transition: translate 0.25s var(--ease-out);
    }

    &:hover {
      color: var(--accent-pink);

      :global(svg) {
        translate: 2px -2px;
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .deck__card a {
      transition: none;
    }
  }
</style>
