---
import { t } from "i18next";

import Glow from "@/components/atoms/Glow.astro";
import TechTag from "@/components/atoms/TechTag.astro";
import SectionTitle from "@/components/molecules/SectionTitle.astro";
import { stack } from "@/utils/stack";

const paragraphs = ["first", "second", "third", "fourth"];
const iconColors = [
  "var(--accent-violet)",
  "var(--accent-pink)",
  "var(--accent-blue)",
];
---

<section class="about" id="about" aria-labelledby="about-title">
  <Glow
    tone="plum"
    style="top: -4.4rem; left: calc(50% - 1px); width: 80rem; height: 80rem;"
    duration={38}
    dx="-3rem"
    dy="-2rem"
  />
  <Glow
    tone="crimson"
    style="bottom: -18rem; left: -14rem; width: 36rem; height: 36rem;"
    duration={30}
    dx="2rem"
    dy="-2rem"
  />

  <div class="container">
    <SectionTitle id="about-title">{t("about.title")}</SectionTitle>

    <div class="about__layout">
      <div class="about__text">
        {paragraphs.map((key) => <p set:html={t(`about.${key}`)} />)}
      </div>

      <aside class="about__stack" aria-labelledby="stack-title">
        <h3 id="stack-title">{t("about.stack.title")}</h3>
        <dl>
          {
            stack.map(({ id, icon: GroupIcon, items }, index) => (
              <div
                class="about__group"
                style={`--group-color: ${iconColors[index % iconColors.length]}`}
              >
                <dt>
                  <GroupIcon
                    size={18}
                    class="about__group-icon"
                    aria-hidden="true"
                  />
                  {t(`about.stack.groups.${id}`)}
                </dt>
                <dd>
                  <ul>
                    {items.map((item) => (
                      <TechTag name={item} />
                    ))}
                  </ul>
                </dd>
              </div>
            ))
          }
        </dl>
      </aside>
    </div>
  </div>
</section>

<style>
  .about {
    position: relative;
    padding-block: var(--section-space);
  }

  .about__layout {
    display: grid;
    grid-template-columns: minmax(0, var(--split-text)) minmax(0, 23rem);
    gap: 3rem var(--split-gap);
    margin-top: 1.9rem;

    @media (max-width: 900px) {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .about__text {
    display: grid;
    gap: 1.65rem;

    p {
      font-size: clamp(1.15rem, 1rem + 0.5vw, 1.375rem);
      line-height: 1.2;
      color: var(--text-soft);
    }

    :global(strong) {
      font-weight: 700;
      color: var(--text);
    }
  }

  .about__stack {
    padding-top: 0.1rem;

    h3 {
      font-size: 1rem;
      font-weight: 700;
      line-height: 1.2;
      color: var(--text);
    }

    dl {
      display: grid;
      gap: 1.05rem;
      margin-top: 1.1rem;
    }
  }

  .about__group {
    display: grid;
    gap: 0.45rem;

    dt {
      display: flex;
      align-items: center;
      gap: 0.45rem;
      font-size: 0.875rem;
      font-weight: 500;
      color: var(--text-muted);
    }

    :global(.about__group-icon) {
      flex-shrink: 0;
      color: color-mix(in oklab, var(--group-color) 80%, var(--text-muted));
    }

    ul {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }
  }
</style>
