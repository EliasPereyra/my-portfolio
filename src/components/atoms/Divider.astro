---
interface Props {
  offset?: string;
}

const { offset = "0px" } = Astro.props;
---

<span class="divider" style={`--divider-offset: ${offset}`} aria-hidden="true"
></span>

<style>
  /*
   * Section seam: a hairline across the sheet with a registration mark (a
   * crosshair inside a ring) where it meets each rail.
   */
  .divider {
    --mark-size: 17px;

    position: absolute;
    z-index: 2;
    top: var(--divider-offset);
    left: 50%;
    width: min(var(--container), 100% - 1.25rem);
    height: 1px;
    translate: -50% 0;
    background: var(--line);

    &::before,
    &::after {
      content: "";
      position: absolute;
      top: calc(var(--mark-size) / -2 + 0.5px);
      width: var(--mark-size);
      height: var(--mark-size);
      background:
        linear-gradient(var(--mark), var(--mark)) center / 100% 1px no-repeat,
        linear-gradient(var(--mark), var(--mark)) center / 1px 100% no-repeat,
        radial-gradient(
          circle,
          transparent 3.6px,
          var(--mark) 4px 4.8px,
          transparent 5.2px
        );
    }

    &::before {
      left: calc(var(--mark-size) / -2);
    }

    &::after {
      right: calc(var(--mark-size) / -2);
    }
  }
</style>
