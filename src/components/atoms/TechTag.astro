---
import { getTechColor } from "@/utils/TechColors";

interface Props {
  name: string;
}

const { name } = Astro.props;
---

<li class="tech-tag" style={`--tag-color: ${getTechColor(name)}`}>{name}</li>

<style>
  .tech-tag {
    --tint: color-mix(in oklab, var(--tag-color) 55%, var(--text-muted));

    padding: 2px 10px;
    border: 1px solid color-mix(in oklab, var(--tint) 60%, transparent);
    border-radius: var(--radius);
    background-color: color-mix(in oklab, var(--tag-color) 8%, transparent);
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.35;
    white-space: nowrap;
    color: color-mix(in oklab, var(--tint) 45%, var(--text));
    transition:
      border-color 0.25s ease,
      background-color 0.25s ease,
      box-shadow 0.25s ease,
      color 0.25s ease;

    &:hover {
      border-color: var(--tag-color);
      background-color: color-mix(in oklab, var(--tag-color) 18%, transparent);
      box-shadow:
        0 0 12px color-mix(in oklab, var(--tag-color) 45%, transparent),
        inset 0 0 8px color-mix(in oklab, var(--tag-color) 20%, transparent);
      color: var(--text);
    }
  }
</style>
