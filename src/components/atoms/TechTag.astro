---
import { getTechColor } from "@/utils/TechColors";

interface Props {
  name: string;
}

const { name } = Astro.props;
---

<li class="tech-tag" style={`--tag-color: ${getTechColor(name)}`}>{name}</li>

<style>
  /* Monochrome part label; the technology's own color only shows on hover */
  .tech-tag {
    padding: 0.2rem 0.55rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    font-family: var(--font-mono);
    font-size: var(--mono-sm);
    font-weight: 500;
    line-height: 1.35;
    white-space: nowrap;
    color: var(--text-soft);
    transition:
      border-color 0.25s ease,
      background-color 0.25s ease,
      color 0.25s ease;

    &:hover {
      border-color: color-mix(in oklab, var(--tag-color) 70%, var(--text));
      background-color: color-mix(in oklab, var(--tag-color) 10%, transparent);
      color: var(--text);
    }
  }
</style>
